# Plantilla — copia a .env y completa con los valores reales.
# NUNCA pongas valores reales aquí (este archivo se versiona).

# Supabase (mismos secrets que mp_sync)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...

# Clasificador
ANTHROPIC_API_KEY=sk-ant-...
RADAR_MODELO=claude-sonnet-4-5

# Scraper
CORE_MIN_CHARS_PAGINA=200     # bajo esto se asume PDF escaneado y se manda a OCR
CORE_MAX_MB=40                # PDFs más grandes se descartan
CORE_MAX_POR_CORRIDA=15       # tope de documentos por fuente por corrida
CORE_OCR=1                    # 0 desactiva OCR (los escaneados quedan en error)

# Clasificador — tuning
RADAR_MAX_PASAJES=25          # tope de pasajes por documento
RADAR_VENTANA_FUSION=900      # pasajes a menos de N chars se funden en uno
RADAR_LIMITE_DOCS=50          # documentos por corrida
